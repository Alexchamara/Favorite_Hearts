---
/**
 * Canonical, language alternates, robots, Open Graph / Twitter tags and JSON-LD for every page.
 * Same output the demo's build.py injected, now as a component. Each page exists in English and in Sinhala (under
 * /si/); both name each other with hreflang, and English is the default (x-default).
 */
import { base, site } from '../lib/site';
import { LANGS, pathIn, texts, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** The page's route without its language, e.g. "/pricing/". */
  route: string;
  title: string;
  description?: string | null;
  headline?: string | null;
}

const { lang, route, title } = Astro.props;
const { t, path } = texts(lang);
const description = Astro.props.description ?? t('web.seo.defaultDescription', { title });
const headline = Astro.props.headline ?? title;
const urlIn = (language: Lang) => base + pathIn(language, route);
const url = urlIn(lang);
const home = base + path('/');
const article = route.startsWith('/newsroom/') && route !== '/newsroom/';
const robots = site.indexable ? 'index, follow, max-image-preview:large' : 'noindex, nofollow';
// A 1200×630 photo, the size link previews use (Facebook, WhatsApp, X).
const image = `${base}/assets/og-image.jpg`;
const imageAlt = t('web.seo.imageAlt');
const locale = (language: Lang) => (language === 'si' ? 'si_LK' : site.language.replace('-', '_'));

const page: Record<string, unknown> = {
  '@type': article ? 'Article' : 'WebPage',
  '@id': `${url}#page`,
  url,
  name: title,
  description,
  inLanguage: lang,
  isPartOf: { '@id': `${base}/#website` },
};
if (article) {
  Object.assign(page, {
    headline,
    author: { '@type': 'Organization', name: site.siteName },
    publisher: { '@id': `${base}/#organization` },
  });
}
const graph: unknown[] = [
  { '@type': 'Organization', '@id': `${base}/#organization`, name: site.siteName, url: `${base}/`, email: site.email, telephone: site.telephone },
  { '@type': 'WebSite', '@id': `${base}/#website`, url: `${base}/`, name: site.siteName, inLanguage: [...LANGS], publisher: { '@id': `${base}/#organization` } },
  page,
];
if (route !== '/') {
  const crumbs = [{ '@type': 'ListItem', position: 1, name: t('web.seo.home'), item: home }];
  if (article) crumbs.push({ '@type': 'ListItem', position: 2, name: t('web.nav.newsroom'), item: base + path('/newsroom/') });
  crumbs.push({ '@type': 'ListItem', position: crumbs.length + 1, name: headline, item: url });
  graph.push({ '@type': 'BreadcrumbList', itemListElement: crumbs });
}
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<link rel="canonical" href={url} />
{LANGS.map((language) => <link rel="alternate" hreflang={language} href={urlIn(language)} />)}
<link rel="alternate" hreflang="x-default" href={urlIn('en')} />
<meta name="robots" content={robots} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={site.siteName} />
<meta property="og:locale" content={locale(lang)} />
{LANGS.filter((language) => language !== lang).map((language) => <meta property="og:locale:alternate" content={locale(language)} />)}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
<script is:inline type="application/ld+json" set:html={jsonLd} />

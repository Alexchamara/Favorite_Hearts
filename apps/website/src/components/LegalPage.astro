---
/**
 * Layout of the terms and the privacy policy: a contents list and numbered sections. A section's body is a list of
 * paragraphs (HTML from the page's catalogue texts) and bulleted lists (arrays). Both documents are drafts until the
 * owner's lawyer approves them (OWNER-DECISIONS Part 2), and English is the official version (owner, 31 Oct 2026):
 * the Sinhala pages say so in their draft note.
 */
import Header from './Header.astro';
import Navigation from './Navigation.astro';
import Footer from './Footer.astro';
import Dialogs from './Dialogs.astro';
import Seo from './Seo.astro';
import { css, js } from '../lib/site';
import { texts, type Lang } from '../lib/i18n';

export type LegalSection = { id: string; title: string; body: (string | string[])[] };

interface Props {
  lang: Lang;
  route: string;
  title: string;
  heading: string;
  description: string;
  lead: string;
  updated: string;
  sections: LegalSection[];
  other: { href: string; label: string };
}

const { lang, route, title, heading, description, lead, updated, sections, other } = Astro.props;
const { t, html, path } = texts(lang);
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#ffffff">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="stylesheet" href={css("landing.css")}>
<script is:inline src={js("site-config.js")} defer>
</script>
<script is:inline src={js("site.js")} defer>
</script>
<script is:inline src={js("legal.js")} defer>
</script>
<link rel="stylesheet" href={css("monochrome.css")}>
<link rel="stylesheet" href={css("legal.css")}>
<link rel="stylesheet" href={css("welcome.css")}>
<script is:inline src={js("welcome.js")} defer>
</script>
<script is:inline src={js("motion.js")} defer></script>
<link rel="stylesheet" href={css("design-system.css")}>
<link rel="stylesheet" href={css("tailwind.css")}>
<Seo lang={lang} route={route} title={title} description={description} headline={heading} />
</head>
<body class="tw-antialiased">
<a class="skip" href="#main">{t('web.common.skip')}</a>
<Header lang={lang} />
<Navigation lang={lang} />
<main id="main" class="legal-page" data-theme="light">
<section class="section legal-intro">
<p class="label">{t('web.legal.label')}</p>
<h1>{heading}</h1>
<p class="legal-lead">{lead}</p>
<p class="legal-date">{t('web.legal.updated', { date: updated })}</p>
<p class="legal-draft" role="note" set:html={html('web.legal.draft')}></p>
</section>
<div class="section legal-layout">
<aside class="legal-contents" aria-label={t('web.legal.onThisPage')}>
<p>{t('web.legal.onThisPage')}</p>
<nav aria-label={t('web.legal.contents')}>
{sections.map((section, i) => (
<a href={`#${section.id}`}>{String(i + 1).padStart(2, '0')} <span>{section.title}</span>
</a>
))}
</nav>
</aside>
<article class="legal-body">
{sections.map((section, i) => (
<section id={section.id}>
<p class="legal-number">{String(i + 1).padStart(2, '0')}</p>
<h2>{section.title}</h2>
{section.body.map((part) =>
  Array.isArray(part) ? (
<ul>
{part.map((item) => <li set:html={item} />)}
</ul>
  ) : (
<p set:html={part} />
  ),
)}
</section>
))}
<div class="legal-end">
<a class="pill" href={path('/contact/')}>{t('web.common.contactUs')}</a>
<a href={other.href}>{other.label} <span aria-hidden="true">↗</span>
</a>
</div>
</article>
</div>
</main><Footer lang={lang} />
<Dialogs lang={lang} />
</body>
</html>

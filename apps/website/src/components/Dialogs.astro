---
// Shared dialogs (from the demo partial dialogs.html): the general dialog, and the language and country choice. Choosing
// the other language opens the same page in it (welcome.js). The page's scripts get their words from #fh-text.
import { texts, type Lang } from '../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const { t, countries, scriptTexts } = texts(lang);
const scriptJson = JSON.stringify({ lang, texts: scriptTexts() }).replace(/</g, '\\u003c');
---
<dialog id="dialog" aria-labelledby="dialog-title">
<button class="close" aria-label={t('web.dialog.close')}>×</button>
<p class="label">Favorite Hearts</p>
<h2 id="dialog-title">{t('web.dialog.title')}</h2>
<div id="dialog-content">
</div>
</dialog>
<dialog id="welcome-dialog" aria-labelledby="welcome-title" aria-describedby="welcome-description">
<form id="welcome-form">
<div class="logo welcome-logo" aria-label="Favorite Hearts">favorite<span>hearts</span>
</div>
<h2 id="welcome-title" tabindex="-1">{t('web.welcome.title')}</h2>
<p id="welcome-description">{t('web.welcome.description')}</p>
<fieldset class="welcome-languages">
<legend>{t('web.welcome.language')}</legend>
<label>
<input type="radio" name="language" value="en" checked={lang === 'en'}>
<span lang="en">English<small>{t('web.lang.label.en')}</small>
</span>
<i aria-hidden="true">
</i>
</label>
<label>
<input type="radio" name="language" value="si" checked={lang === 'si'}>
<span lang="si">සිංහල<small>{t('web.lang.label.si')}</small>
</span>
<i aria-hidden="true">
</i>
</label>
</fieldset>
<label class="welcome-country-label" for="welcome-country">{t('web.welcome.country')}</label>
<div class="welcome-country-wrap">
<select id="welcome-country" name="country" required>
{countries().map(({ code, name }) => <option value={code} selected={code === 'LK'}>{name}</option>)}
</select>
<span aria-hidden="true">⌄</span>
</div>
<button class="pill welcome-continue" type="submit">{t('web.welcome.continue')}</button>
<p class="welcome-footnote">{t('web.welcome.footnote')}</p>
</form>
</dialog>
<script type="application/json" id="fh-text" set:html={scriptJson} />

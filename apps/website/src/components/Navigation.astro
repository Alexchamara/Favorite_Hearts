---
// Shared navigation (from the demo partial navigation.html). A social button appears only once that page's real
// address is set in site.config.json.
import { routeOf, texts, type Lang } from '../lib/i18n';
import { site } from '../lib/site';

const social = site.social as Record<string, string | null>;
const anySocial = Object.values(social).some(Boolean);
const { lang } = Astro.props as { lang: Lang };
const { t, path, other } = texts(lang);
const counterpart = texts(other).path(routeOf(Astro.url.pathname));
---
<nav id="navigation" aria-label={t('web.nav.label')} hidden>
<div class="menu-items">
<a href={path('/mission/')} class="mission-link">{t('web.nav.mission')} <span class="menu-link-arrow" aria-hidden="true">↗</span>
</a>
<a href={path('/labs/')}>{t('web.nav.labs')} <span class="menu-link-arrow" aria-hidden="true">↗</span>
</a>
<a href={path('/newsroom/')}>{t('web.nav.newsroom')} <span class="menu-link-arrow" aria-hidden="true">↗</span>
</a>
<a href={path('/contact/')}>{t('web.nav.contact')} <span class="menu-link-arrow" aria-hidden="true">↗</span>
</a>
<a href={path('/help/')}>{t('web.nav.help')} <span class="menu-link-arrow" aria-hidden="true">↗</span>
</a>
<a href={path('/privacy/')}>{t('web.nav.privacy')} <span class="menu-link-arrow" aria-hidden="true">↗</span>
</a>
<a href={path('/terms/')}>{t('web.nav.terms')} <span class="menu-link-arrow" aria-hidden="true">↗</span>
</a>
<a class="menu-language" href={counterpart} hreflang={other} lang={other} aria-label={t(`web.lang.to.${other}`)}>{t(`web.lang.name.${other}`)} <span class="menu-link-arrow" aria-hidden="true">↗</span>
</a>
</div>
<div class="menu-bottom-row">
{anySocial && (
<div class="menu-social" aria-label={t('web.nav.social')}>
{social.Instagram && (
<button type="button" data-social="Instagram" aria-label="Instagram">
<svg viewBox="0 0 24 24" aria-hidden="true">
<defs>
<linearGradient id="instagram-brand" x1="0" y1="1" x2="1" y2="0">
<stop offset="0%" stop-color="#FCAF45"/>
<stop offset="35%" stop-color="#F77737"/>
<stop offset="65%" stop-color="#E1306C"/>
<stop offset="100%" stop-color="#833AB4"/>
</linearGradient>
</defs>
<path style="fill:url(#instagram-brand)" fill-rule="evenodd" d="M7 1h10a6 6 0 0 1 6 6v10a6 6 0 0 1-6 6H7a6 6 0 0 1-6-6V7a6 6 0 0 1 6-6Zm5 5a6 6 0 1 0 0 12 6 6 0 0 0 0-12Zm0 2a4 4 0 1 1 0 8 4 4 0 0 1 0-8Zm6.4-4a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8Z"/>
</svg>
</button>
)}
{social.Facebook && (
<button type="button" data-social="Facebook" aria-label="Facebook">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.84c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.23.2 2.23.2v2.47h-1.26c-1.24 0-1.62.78-1.62 1.57v1.89h2.77l-.44 2.91h-2.33V22C18.34 21.24 22 17.08 22 12.06Z"/>
</svg>
</button>
)}
{social.TikTok && (
<button type="button" data-social="TikTok" aria-label="TikTok">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path style="fill:#25F4EE" transform="translate(-.7,-.5)" d="M16.7 2c.2 2.5 1.6 4 4.3 4.2v3.5a9 9 0 0 1-4.3-1.3v7.7a6.6 6.6 0 1 1-5.7-6.6v3.6a3.1 3.1 0 1 0 2.2 3V2h3.5Z"/>
<path style="fill:#FE2C55" transform="translate(.7,.5)" d="M16.7 2c.2 2.5 1.6 4 4.3 4.2v3.5a9 9 0 0 1-4.3-1.3v7.7a6.6 6.6 0 1 1-5.7-6.6v3.6a3.1 3.1 0 1 0 2.2 3V2h3.5Z"/>
<path style="fill:#111" d="M16.7 2c.2 2.5 1.6 4 4.3 4.2v3.5a9 9 0 0 1-4.3-1.3v7.7a6.6 6.6 0 1 1-5.7-6.6v3.6a3.1 3.1 0 1 0 2.2 3V2h3.5Z"/>
</svg>
</button>
)}
</div>
)}
<p class="menu-bottom">
<svg class="menu-info" viewBox="0 0 24 24" aria-hidden="true">
<circle cx="12" cy="12" r="9"/>
<path d="M12 11v6"/>
<circle cx="12" cy="7.5" r=".8" fill="currentColor" stroke="none"/>
</svg>
<span>{t('web.nav.note')}</span>
</p>
</div>
</nav>

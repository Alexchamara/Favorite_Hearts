---
// Privacy policy (Stage 5b): a draft for the owner's lawyer that lists exactly what is collected, who sees it, and what
// is kept and for how long (OWNER-DECISIONS sections 6–8; audit rows W10, W11, X02, X04). It matches what the app does
// (docs/ARCHITECTURE.md, "Safety"). The points the lawyer must check are listed in docs/LEGAL-REVIEW.md.
import LegalPage, { type LegalSection } from '../../components/LegalPage.astro';
import { site } from '../../lib/site';

const operator = '<mark class="legal-placeholder">[operator’s legal name and address]</mark>';
const email = `<a href="mailto:${site.email}">${site.email}</a>`;

const sections: LegalSection[] = [
  {
    id: 'about',
    title: 'About this policy',
    body: [
      `This policy explains how ${operator} (“we”, “us”) collects, uses, shares and keeps personal information when you use the Favorite Hearts website and app. The English text is the official version.`,
      `For any question or request about your information, email ${email} with the subject “Privacy request”.`,
    ],
  },
  {
    id: 'collect',
    title: 'What we collect',
    body: [
      [
        '<strong>Your account</strong>: your name, your email address and/or phone number, and your sign-in. Sign-in codes expire after 10 minutes.',
        '<strong>Profiles you run</strong>: the details you enter, such as gender, date of birth, where the candidate lives, education, occupation, height, marital status, languages, family details, an introduction, values and interests; up to 5 photos; contact details and social handles.',
        '<strong>Optional sensitive details</strong>: religion, caste and income range. Each is optional, with “Prefer not to say”. Caste is saved only with your explicit consent and can be removed at any time; income is shown as a range labelled self-declared.',
        '<strong>Verification</strong>: a photo of your identity document (NIC, passport or driving licence), your verified phone number, and our review decision.',
        '<strong>Activity</strong>: requests, connections, blocks, reports, plan history, and a record of which kinds of details were shared with whom and when (the kinds, never the details themselves).',
        '<strong>Payments</strong>: the country you live in, the plan, amount, payment method and reference, the receipt photos or screenshots you upload, the matching line of our statement, and our decision.',
        '<strong>Messages</strong> you send us, and the emails we send you.',
        '<strong>Technical information</strong>: your IP address and device details, used for security and to limit abuse.',
      ],
    ],
  },
  {
    id: 'use',
    title: 'How we use it',
    body: [
      'We use your information to run Favorite Hearts: to publish and show profiles, send and answer requests, share details after both sides accept, review identity documents and phone numbers, check payments, send you emails about your account (sign-in codes, invitations, payment decisions and plan reminders), keep members safe (reports, moderation, limits on attempts and a bot check), and meet our legal obligations.',
      'We do not sell personal information, we do not show advertising, and we do not use your information for anything unrelated to finding a marriage partner.',
    ],
  },
  {
    id: 'sharing',
    title: 'Who sees what',
    body: [
      [
        '<strong>Visitors who are not signed in</strong> see no profiles at all.',
        '<strong>Signed-in members whose own identity check is complete</strong> can see published profiles: the age (never the date of birth), the details the profile shows, caste only if you consented, the cover photo only if you allow it, and the other photos blurred.',
        '<strong>A member without a plan who receives a request</strong> sees the sender’s age and occupation, not who sent it.',
        '<strong>Once both sides accept a request</strong>, each side sees the other’s contact details and social handles (the candidate’s and the managing family member’s), the full photo gallery and the parents’ names. The candidate can limit which contact details are shared. Details that have been shared cannot be taken back.',
        '<strong>The people who run a profile</strong> (the candidate and a managing family member) see it according to the permissions the candidate sets.',
        '<strong>Our staff</strong>: the owner and one backup reviewer, each with two-step sign-in. The backup reviewer reviews documents and reports and has no access to payments. Every look at an identity document or a receipt is logged.',
      ],
    ],
  },
  {
    id: 'providers',
    title: 'Service providers and where your information is processed',
    body: [
      'We use these providers to run Favorite Hearts. They process information only to provide their service to us:',
      [
        'Neon: our database, in Singapore.',
        'Cloudflare: website hosting, private file storage (R2), and the Turnstile bot check on sign-in forms.',
        'Resend: sending email.',
        'Pexels: some photos on the public website are loaded from the Pexels image library, so your browser contacts Pexels to show them.',
        'An SMS provider for sign-in and verification codes, and a host for our application server; both will be named here before launch.',
      ],
      'Your information is therefore stored and processed outside Sri Lanka. We share information with authorities only when the law requires it.',
    ],
  },
  {
    id: 'security',
    title: 'How we protect it',
    body: [
      'Connections are encrypted. Identity documents, receipts and original photos are kept in private storage and are shown only through links that expire within minutes, and only to people allowed to see them. Members who may not yet see a photo receive a separate blurred copy. Staff sign in with two-step login, and sign-in and code attempts are limited. Favorite Hearts staff will never ask for your password or a code.',
      'No system is perfectly secure. If you notice something wrong, tell us at once.',
    ],
  },
  {
    id: 'retention',
    title: 'How long we keep it',
    body: [
      [
        '<strong>Identity documents</strong> are deleted 90 days after our review, whether approved or rejected. After that we keep only the document type, the reviewer, the date and the decision.',
        '<strong>While your account is open</strong>, we keep your information for as long as it is needed to run the service.',
        '<strong>When you delete a profile</strong>, it disappears at once. Its details, photos, contact details, social handles, requests, connections and shortlists are deleted at once. Its payment records and receipts, plan history, reports and blocks, and our staff’s record of their actions are kept for 6 months, then deleted.',
        '<strong>When you delete your account</strong>, every profile you run is deleted as above, except a profile whose candidate has joined it, which passes to the candidate. Your name, email address and phone number are removed from the account at once, your identity document is deleted at once, and you are signed out everywhere. For 6 months we keep only the records listed above and a scrambled form of your email address and phone number, used only to stop a banned person from signing up again. Then they are deleted too.',
      ],
      'Details already shared with your connections cannot be taken back from them.',
    ],
  },
  {
    id: 'rights',
    title: 'Your choices and rights',
    body: [
      [
        '<strong>See and download</strong>: Download my data in the app gives you one file with your profiles, contact details, photos, requests, connections and payments.',
        '<strong>Correct</strong>: edit your profile in the app at any time.',
        '<strong>Delete</strong>: delete a profile or your account in the app.',
        '<strong>Withdraw consent or limit sharing</strong>: remove your caste, choose which contact details connections receive, or pause the profile.',
      ],
      `For anything else, email ${email} with the subject “Privacy request”. We may ask you to confirm that the request comes from you. You may also complain to the data protection authority of the country you live in.`,
    ],
  },
  {
    id: 'children',
    title: 'Under 18s',
    body: [
      'Favorite Hearts is only for adults. If you believe a profile belongs to someone under 18, report it: it is hidden at once while our staff review it.',
    ],
  },
  {
    id: 'storage',
    title: 'Cookies and storage in your browser',
    body: [
      [
        'When you sign in, the app sets one cookie that keeps you signed in. We use no advertising or tracking cookies.',
        'The website remembers your language and country if you choose them, and the app remembers whether you prefer the light or dark theme. Both stay in your browser.',
        'On sign-in and code forms, Cloudflare Turnstile checks that you are a person; Cloudflare processes technical information about your browser to do this.',
      ],
    ],
  },
  {
    id: 'changes',
    title: 'Changes and contact',
    body: [
      'We will update this policy when our practices change and show the new date at the top. We tell members about important changes before they take effect.',
      `Contact: ${operator}, ${email}, or WhatsApp and calls on 076 676 9894.`,
    ],
  },
];
---
<LegalPage
  route="/privacy/"
  title="Privacy Policy — Favorite Hearts"
  heading="Privacy Policy"
  description="What we collect, who can see it, how it is protected, and what is kept, and for how long, after you delete a profile or account. Draft awaiting legal review."
  lead="Your information deserves thoughtful care."
  updated="31 October 2026"
  sections={sections}
  other={{ href: '/terms/', label: 'Terms & Conditions' }}
/>

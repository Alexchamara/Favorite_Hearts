---
// Converted from the demo page src/pages/contact/index.html — content unchanged.
import Header from '../../components/Header.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Dialogs from '../../components/Dialogs.astro';
import Seo from '../../components/Seo.astro';
import { css, js } from '../../lib/site';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#ffffff">
<title>Contact Us — Favorite Hearts</title>
<meta name="description" content="Find support, general enquiries and community updates from Favorite Hearts. A thoughtful place to start with your questions.">
<link rel="stylesheet" href={css("landing.css")}>
<script is:inline src={js("site-config.js")} defer>
</script>
<script is:inline src={js("site.js")} defer>
</script>
<script is:inline src={js("contact.js")} defer>
</script>
<link rel="stylesheet" href={css("monochrome.css")}>
<link rel="stylesheet" href={css("contact.css")}>
<link rel="stylesheet" href={css("welcome.css")}>
<script is:inline src={js("welcome.js")} defer>
</script>
<script is:inline src={js("motion.js")} defer></script>
<link rel="stylesheet" href={css("design-system.css")}>
<link rel="stylesheet" href={css("tailwind.css")}>
<Seo route="/contact/" title={"Contact Us — Favorite Hearts"} description={"Find support, general enquiries and community updates from Favorite Hearts. A thoughtful place to start with your questions."} headline={"Contact us."} />
</head>
<body class="tw-antialiased">
<a class="skip" href="#main">Skip to content</a>
<Header />
<Navigation />
<main id="main" class="contact-page" data-theme="light">
<section class="section contact-intro">
<p class="label">Here for you</p>
<h1>Contact us.</h1>
<p>We’re here to help with your account, introductions,<br>verification, safety concerns, and general enquiries.</p>
</section>
<section class="section contact-channels" aria-label="Ways to contact Favorite Hearts">
<div class="contact-grid">
<article class="contact-card">
<div class="contact-card-top">
<span class="contact-icon whatsapp">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path fill="currentColor" d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.5 0 .2 5.3.2 11.9c0 2.1.6 4.2 1.6 6L0 24l6.3-1.7a12 12 0 0 0 5.8 1.5h.1A11.9 11.9 0 0 0 24 11.9c0-3.2-1.2-6.2-3.5-8.4ZM12.1 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.3-.4a9.9 9.9 0 1 1 8.4 4.6Zm5.4-7.4c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.1 8.1 0 0 1-4-3.5c-.3-.4.3-.4.9-1.6.1-.2.1-.4 0-.6l-.9-2.1c-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.3 3.1c.1.2 2.1 3.3 5.1 4.6 1.9.8 2.6.9 3.6.8.6-.1 1.8-.7 2.1-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.3-.7-.4Z"/>
</svg>
</span>
<div class="contact-card-heading">
<h2>WhatsApp Support</h2>
<p class="contact-service-label">Fastest response</p>
</div>
</div>
<h3 class="contact-card-subheading">Quick support & safety</h3>
<p class="contact-description">For customer support, safety concerns, profile changes, payment enquiries, and verification questions. Tell us what you need help with and our team will get back to you.</p>
<p class="contact-address contact-phone">
<span>076</span> <span>676</span> <span>9894</span>
</p>
<div class="contact-hours">
<p>Daily, 8:00 AM – 10:00 PM <span>(Sri Lanka time)</span>
</p>
<p class="contact-hours-note">Send safety reports on WhatsApp at any time. Our team responds during support hours.</p>
</div>
<a class="pill contact-action" href="https://wa.me/94766769894" target="_blank" rel="noopener noreferrer">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path fill="currentColor" d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.5 0 .2 5.3.2 11.9c0 2.1.6 4.2 1.6 6L0 24l6.3-1.7a12 12 0 0 0 5.8 1.5h.1A11.9 11.9 0 0 0 24 11.9c0-3.2-1.2-6.2-3.5-8.4ZM12.1 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.3-.4a9.9 9.9 0 1 1 8.4 4.6Zm5.4-7.4c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.1 8.1 0 0 1-4-3.5c-.3-.4.3-.4.9-1.6.1-.2.1-.4 0-.6l-.9-2.1c-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.3 3.1c.1.2 2.1 3.3 5.1 4.6 1.9.8 2.6.9 3.6.8.6-.1 1.8-.7 2.1-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.3-.7-.4Z"/>
</svg>
<span>Chat on WhatsApp</span>
</a>
</article>
<article class="contact-card">
<div class="contact-card-top">
<span class="contact-icon mail">
<svg viewBox="0 0 24 24" aria-hidden="true">
<rect x="3" y="5" width="18" height="14" rx="2"/>
<path d="m3 7 9 6 9-6"/>
</svg>
</span>
<div class="contact-card-heading">
<h2>Email us</h2>
<p class="contact-service-label">Official enquiries</p>
</div>
</div>
<h3 class="contact-card-subheading">Questions, ideas & feedback</h3>
<p class="contact-description">For account management, feedback, press and editorial enquiries, or partnership ideas. Include a short description so we can direct your message to the right person.</p>
<p class="contact-address">hello@favoritehearts.com</p>
<div class="contact-hours">
<p>Support hours: 8:00 AM – 10:00 PM daily <span>(Sri Lanka time)</span>
</p>
</div>
<a class="pill contact-action" href="mailto:hello@favoritehearts.com">
<svg viewBox="0 0 24 24" aria-hidden="true">
<rect x="3" y="5" width="18" height="14" rx="2"/>
<path d="m3 7 9 6 9-6"/>
</svg>
<span>Send email</span>
</a>
</article>
<article class="contact-card">
<div class="contact-card-top">
<span class="contact-icon facebook">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.84c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.23.2 2.23.2v2.47h-1.26c-1.24 0-1.62.78-1.62 1.57v1.89h2.77l-.44 2.91h-2.33V22C18.34 21.24 22 17.08 22 12.06Z"/>
</svg>
</span>
<div class="contact-card-heading">
<h2>Facebook</h2>
<p class="contact-service-label">Official page</p>
</div>
</div>
<h3 class="contact-card-subheading">Latest from our community</h3>
<p class="contact-description">Follow Favorite Hearts for announcements, helpful relationship ideas, and the latest updates from our community.</p>
<p class="contact-address">Favorite Hearts</p>
<a class="pill contact-action" href="https://www.facebook.com/search/pages/?q=Favorite%20Hearts" target="_blank" rel="noopener noreferrer">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.84c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.23.2 2.23.2v2.47h-1.26c-1.24 0-1.62.78-1.62 1.57v1.89h2.77l-.44 2.91h-2.33V22C18.34 21.24 22 17.08 22 12.06Z"/>
</svg>
<span>Join Facebook</span>
</a>
</article>
<article class="contact-card">
<div class="contact-card-top">
<span class="contact-icon tiktok">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path style="fill:#25F4EE" transform="translate(-.7,-.5)" d="M16.7 2c.2 2.5 1.6 4 4.3 4.2v3.5a9 9 0 0 1-4.3-1.3v7.7a6.6 6.6 0 1 1-5.7-6.6v3.6a3.1 3.1 0 1 0 2.2 3V2h3.5Z"/>
<path style="fill:#FE2C55" transform="translate(.7,.5)" d="M16.7 2c.2 2.5 1.6 4 4.3 4.2v3.5a9 9 0 0 1-4.3-1.3v7.7a6.6 6.6 0 1 1-5.7-6.6v3.6a3.1 3.1 0 1 0 2.2 3V2h3.5Z"/>
<path style="fill:#111" d="M16.7 2c.2 2.5 1.6 4 4.3 4.2v3.5a9 9 0 0 1-4.3-1.3v7.7a6.6 6.6 0 1 1-5.7-6.6v3.6a3.1 3.1 0 1 0 2.2 3V2h3.5Z"/>
</svg>
</span>
<div class="contact-card-heading">
<h2>TikTok</h2>
<p class="contact-service-label">Official account</p>
</div>
</div>
<h3 class="contact-card-subheading">A little inspiration</h3>
<p class="contact-description">Find Favorite Hearts for fresh perspectives on relationships, thoughtful conversations, and a little inspiration for your next chapter.</p>
<p class="contact-address">Favorite Hearts</p>
<a class="pill contact-action" href="https://www.tiktok.com/search?q=Favorite%20Hearts" target="_blank" rel="noopener noreferrer">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path style="fill:#25F4EE" transform="translate(-.7,-.5)" d="M16.7 2c.2 2.5 1.6 4 4.3 4.2v3.5a9 9 0 0 1-4.3-1.3v7.7a6.6 6.6 0 1 1-5.7-6.6v3.6a3.1 3.1 0 1 0 2.2 3V2h3.5Z"/>
<path style="fill:#FE2C55" transform="translate(.7,.5)" d="M16.7 2c.2 2.5 1.6 4 4.3 4.2v3.5a9 9 0 0 1-4.3-1.3v7.7a6.6 6.6 0 1 1-5.7-6.6v3.6a3.1 3.1 0 1 0 2.2 3V2h3.5Z"/>
<path style="fill:#111" d="M16.7 2c.2 2.5 1.6 4 4.3 4.2v3.5a9 9 0 0 1-4.3-1.3v7.7a6.6 6.6 0 1 1-5.7-6.6v3.6a3.1 3.1 0 1 0 2.2 3V2h3.5Z"/>
</svg>
<span>Watch TikTok</span>
</a>
</article>
</div>
</section>
<section class="section contact-guide" data-theme="dark" aria-labelledby="contact-guide-title">
<div>
<p class="label">Before you reach out</p>
<h2 id="contact-guide-title">A little detail.<br>A better start.</h2>
<p>Help us understand what you need, while keeping your private information safe.</p>
</div>
<div class="contact-questions">
<details name="contact-help">
<summary>What should I include?<span aria-hidden="true">+</span>
</summary>
<div>
<p>Give a short description of your question and the page or step you were using. For a technical issue, include your device and browser. If you share a screenshot, hide any private details first.</p>
</div>
</details>
<details name="contact-help">
<summary>What should I keep private?<span aria-hidden="true">+</span>
</summary>
<div>
<p>Never share passwords, one-time codes, full bank details, or identity documents through social messages. Keep other people’s personal information out of public comments.</p>
</div>
</details>
<details name="contact-help">
<summary>What if a conversation makes me uncomfortable?<span aria-hidden="true">+</span>
</summary>
<div>
<p>You can stop an interaction at any time. Keep a record of concerning messages and avoid sending money or more personal information. If you are in immediate danger, contact local emergency services. Favorite Hearts support is not an emergency service.</p>
</div>
</details>
<details name="contact-help">
<summary>Where can I learn more about Favorite Hearts?<span aria-hidden="true">+</span>
</summary>
<div>
<p>Discover the values behind Favorite Hearts on our <a href="/mission/">Mission page</a>, explore relationship ideas at <a href="/labs/">Favorite Labs</a>, or find our latest updates in the <a href="/newsroom/">Newsroom</a>.</p>
</div>
</details>
</div>
</section>
</main><Footer />
<Dialogs />
</body>
</html>

---
// Contact (Stage 5b, OWNER-DECISIONS section 10): email, WhatsApp and calls on the support number (owner, 30 Oct 2026),
// and that staff never ask for passwords or codes. Social pages appear only once their real address is configured in
// site.config.json: until then there is no official page to point to.
import Header from '../../../components/Header.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';
import Dialogs from '../../../components/Dialogs.astro';
import Seo from '../../../components/Seo.astro';
import { css, js, site } from '../../../lib/site';
import { langOf, languagePaths, texts } from '../../../lib/i18n';

export function getStaticPaths() {
  return languagePaths();
}

const { lang, t, html, path } = texts(langOf(Astro.params.lang));
const title = t('web.common.pageTitle', { page: t('web.nav.contact') });
const description = t('web.contact.description');
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#ffffff">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="stylesheet" href={css("landing.css")}>
<script is:inline src={js("site-config.js")} defer>
</script>
<script is:inline src={js("site.js")} defer>
</script>
<script is:inline src={js("contact.js")} defer>
</script>
<link rel="stylesheet" href={css("monochrome.css")}>
<link rel="stylesheet" href={css("contact.css")}>
<link rel="stylesheet" href={css("welcome.css")}>
<script is:inline src={js("welcome.js")} defer>
</script>
<script is:inline src={js("motion.js")} defer></script>
<link rel="stylesheet" href={css("design-system.css")}>
<link rel="stylesheet" href={css("tailwind.css")}>
<Seo lang={lang} route="/contact/" title={title} description={description} headline={t('web.contact.headline')} />
</head>
<body class="tw-antialiased">
<a class="skip" href="#main">{t('web.common.skip')}</a>
<Header lang={lang} />
<Navigation lang={lang} />
<main id="main" class="contact-page" data-theme="light">
<section class="section contact-intro">
<p class="label">{t('web.contact.hereForYou')}</p>
<h1>{t('web.contact.headline')}</h1>
<p set:html={html('web.contact.weReHereTo')}></p>
</section>
<section class="section contact-channels" aria-label={t('web.contact.waysToContactFavorite')}>
<div class="contact-grid">
<article class="contact-card">
<div class="contact-card-top">
<span class="contact-icon whatsapp">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path fill="currentColor" d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.5 0 .2 5.3.2 11.9c0 2.1.6 4.2 1.6 6L0 24l6.3-1.7a12 12 0 0 0 5.8 1.5h.1A11.9 11.9 0 0 0 24 11.9c0-3.2-1.2-6.2-3.5-8.4ZM12.1 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.3-.4a9.9 9.9 0 1 1 8.4 4.6Zm5.4-7.4c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.1 8.1 0 0 1-4-3.5c-.3-.4.3-.4.9-1.6.1-.2.1-.4 0-.6l-.9-2.1c-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.3 3.1c.1.2 2.1 3.3 5.1 4.6 1.9.8 2.6.9 3.6.8.6-.1 1.8-.7 2.1-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.3-.7-.4Z"/>
</svg>
</span>
<div class="contact-card-heading">
<h2>{t('web.contact.whatsappSupport')}</h2>
<p class="contact-service-label">{t('web.contact.fastestResponse')}</p>
</div>
</div>
<h3 class="contact-card-subheading">{t('web.contact.quickSupportSafety')}</h3>
<p class="contact-description">{t('web.contact.forCustomerSupportSafety')}</p>
<p class="contact-address contact-phone">
<span>076</span> <span>676</span> <span>9894</span>
</p>
<div class="contact-hours">
<p>{t('web.contact.daily800Am')} <span>{t('web.contact.sriLankaTime')}</span>
</p>
<p class="contact-hours-note">{t('web.contact.sendSafetyReportsOn')}</p>
</div>
<a class="pill contact-action" href="https://wa.me/94766769894" target="_blank" rel="noopener noreferrer">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path fill="currentColor" d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.5 0 .2 5.3.2 11.9c0 2.1.6 4.2 1.6 6L0 24l6.3-1.7a12 12 0 0 0 5.8 1.5h.1A11.9 11.9 0 0 0 24 11.9c0-3.2-1.2-6.2-3.5-8.4ZM12.1 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.3-.4a9.9 9.9 0 1 1 8.4 4.6Zm5.4-7.4c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.1 8.1 0 0 1-4-3.5c-.3-.4.3-.4.9-1.6.1-.2.1-.4 0-.6l-.9-2.1c-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.3 3.1c.1.2 2.1 3.3 5.1 4.6 1.9.8 2.6.9 3.6.8.6-.1 1.8-.7 2.1-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.3-.7-.4Z"/>
</svg>
<span>{t('web.contact.chatOnWhatsapp')}</span>
</a>
</article>
<article class="contact-card">
<div class="contact-card-top">
<span class="contact-icon mail">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2Z"/>
</svg>
</span>
<div class="contact-card-heading">
<h2>{t('web.contact.callUs')}</h2>
<p class="contact-service-label">{t('web.contact.sameNumber')}</p>
</div>
</div>
<h3 class="contact-card-subheading">{t('web.contact.talkToOurTeam')}</h3>
<p class="contact-description">{t('web.contact.callDuringSupportHours')}</p>
<p class="contact-address contact-phone">
<span>076</span> <span>676</span> <span>9894</span>
</p>
<div class="contact-hours">
<p>{t('web.contact.daily800Am')} <span>{t('web.contact.sriLankaTime')}</span>
</p>
</div>
<a class="pill contact-action" href={`tel:${site.telephone}`}>
<svg viewBox="0 0 24 24" aria-hidden="true">
<path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2Z"/>
</svg>
<span>{t('web.contact.call0766769894')}</span>
</a>
</article>
<article class="contact-card">
<div class="contact-card-top">
<span class="contact-icon mail">
<svg viewBox="0 0 24 24" aria-hidden="true">
<rect x="3" y="5" width="18" height="14" rx="2"/>
<path d="m3 7 9 6 9-6"/>
</svg>
</span>
<div class="contact-card-heading">
<h2>{t('web.contact.emailUs')}</h2>
<p class="contact-service-label">{t('web.contact.officialEnquiries')}</p>
</div>
</div>
<h3 class="contact-card-subheading">{t('web.contact.questionsIdeasFeedback')}</h3>
<p class="contact-description">{t('web.contact.forAccountManagementFeedback')}</p>
<p class="contact-address">{site.email}</p>
<div class="contact-hours">
<p>{t('web.contact.supportHours800')} <span>{t('web.contact.sriLankaTime')}</span>
</p>
</div>
<a class="pill contact-action" href="mailto:hello@favoritehearts.com">
<svg viewBox="0 0 24 24" aria-hidden="true">
<rect x="3" y="5" width="18" height="14" rx="2"/>
<path d="m3 7 9 6 9-6"/>
</svg>
<span>{t('web.contact.sendEmail')}</span>
</a>
</article>
{site.social.Facebook && (
<article class="contact-card">
<div class="contact-card-top">
<span class="contact-icon facebook">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.84c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.23.2 2.23.2v2.47h-1.26c-1.24 0-1.62.78-1.62 1.57v1.89h2.77l-.44 2.91h-2.33V22C18.34 21.24 22 17.08 22 12.06Z"/>
</svg>
</span>
<div class="contact-card-heading">
<h2>Facebook</h2>
<p class="contact-service-label">{t('web.contact.officialPage')}</p>
</div>
</div>
<h3 class="contact-card-subheading">{t('web.contact.latestFromOurCommunity')}</h3>
<p class="contact-description">{t('web.contact.followFavoriteHeartsFor')}</p>
<p class="contact-address">Favorite Hearts</p>
<a class="pill contact-action" href={site.social.Facebook} target="_blank" rel="noopener noreferrer">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.84c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.23.2 2.23.2v2.47h-1.26c-1.24 0-1.62.78-1.62 1.57v1.89h2.77l-.44 2.91h-2.33V22C18.34 21.24 22 17.08 22 12.06Z"/>
</svg>
<span>{t('web.contact.joinFacebook')}</span>
</a>
</article>
)}
{site.social.TikTok && (
<article class="contact-card">
<div class="contact-card-top">
<span class="contact-icon tiktok">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path style="fill:#25F4EE" transform="translate(-.7,-.5)" d="M16.7 2c.2 2.5 1.6 4 4.3 4.2v3.5a9 9 0 0 1-4.3-1.3v7.7a6.6 6.6 0 1 1-5.7-6.6v3.6a3.1 3.1 0 1 0 2.2 3V2h3.5Z"/>
<path style="fill:#FE2C55" transform="translate(.7,.5)" d="M16.7 2c.2 2.5 1.6 4 4.3 4.2v3.5a9 9 0 0 1-4.3-1.3v7.7a6.6 6.6 0 1 1-5.7-6.6v3.6a3.1 3.1 0 1 0 2.2 3V2h3.5Z"/>
<path style="fill:#111" d="M16.7 2c.2 2.5 1.6 4 4.3 4.2v3.5a9 9 0 0 1-4.3-1.3v7.7a6.6 6.6 0 1 1-5.7-6.6v3.6a3.1 3.1 0 1 0 2.2 3V2h3.5Z"/>
</svg>
</span>
<div class="contact-card-heading">
<h2>TikTok</h2>
<p class="contact-service-label">{t('web.contact.officialAccount')}</p>
</div>
</div>
<h3 class="contact-card-subheading">{t('web.contact.aLittleInspiration')}</h3>
<p class="contact-description">{t('web.contact.findFavoriteHeartsFor')}</p>
<p class="contact-address">Favorite Hearts</p>
<a class="pill contact-action" href={site.social.TikTok} target="_blank" rel="noopener noreferrer">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path style="fill:#25F4EE" transform="translate(-.7,-.5)" d="M16.7 2c.2 2.5 1.6 4 4.3 4.2v3.5a9 9 0 0 1-4.3-1.3v7.7a6.6 6.6 0 1 1-5.7-6.6v3.6a3.1 3.1 0 1 0 2.2 3V2h3.5Z"/>
<path style="fill:#FE2C55" transform="translate(.7,.5)" d="M16.7 2c.2 2.5 1.6 4 4.3 4.2v3.5a9 9 0 0 1-4.3-1.3v7.7a6.6 6.6 0 1 1-5.7-6.6v3.6a3.1 3.1 0 1 0 2.2 3V2h3.5Z"/>
<path style="fill:#111" d="M16.7 2c.2 2.5 1.6 4 4.3 4.2v3.5a9 9 0 0 1-4.3-1.3v7.7a6.6 6.6 0 1 1-5.7-6.6v3.6a3.1 3.1 0 1 0 2.2 3V2h3.5Z"/>
</svg>
<span>{t('web.contact.watchTiktok')}</span>
</a>
</article>
)}
</div>
</section>
<section class="section contact-guide" data-theme="dark" aria-labelledby="contact-guide-title">
<div>
<p class="label">{t('web.contact.beforeYouReachOut')}</p>
<h2 id="contact-guide-title" set:html={html('web.contact.aLittleDetailA')}></h2>
<p>{t('web.contact.helpUsUnderstandWhat')}</p>
</div>
<div class="contact-questions">
<details name="contact-help">
<summary>{t('web.contact.whatShouldIInclude')}<span aria-hidden="true">+</span>
</summary>
<div>
<p>{t('web.contact.giveAShortDescription')}</p>
</div>
</details>
<details name="contact-help">
<summary>{t('web.contact.whatShouldIKeep')}<span aria-hidden="true">+</span>
</summary>
<div>
<p>{t('web.contact.neverShareAPassword')}</p>
</div>
</details>
<details name="contact-help">
<summary>{t('web.contact.whatIfAConversation')}<span aria-hidden="true">+</span>
</summary>
<div>
<p>{t('web.contact.youCanStopAn')}</p>
</div>
</details>
<details name="contact-help">
<summary>{t('web.contact.whereCanILearn')}<span aria-hidden="true">+</span>
</summary>
<div>
<p set:html={html('web.contact.discoverTheValuesBehind', { link: `<a href="${path('/mission/')}">`, link2: `<a href="${path('/labs/')}">`, link3: `<a href="${path('/newsroom/')}">` })}></p>
</div>
</details>
</div>
</section>
</main><Footer lang={lang} />
<Dialogs lang={lang} />
</body>
</html>

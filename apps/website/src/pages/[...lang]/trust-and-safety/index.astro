---
// Converted from the demo page src/pages/trust-and-safety/index.html; its words are in the website catalogue (web.trust.*).
import Header from '../../../components/Header.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';
import Dialogs from '../../../components/Dialogs.astro';
import Seo from '../../../components/Seo.astro';
import { css, js } from '../../../lib/site';
import { langOf, languagePaths, texts } from '../../../lib/i18n';

export function getStaticPaths() {
  return languagePaths();
}

const { lang, t, html, path } = texts(langOf(Astro.params.lang));
const title = t('web.common.pageTitle', { page: t('web.category.safety') });
const description = t('web.trust.description');
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#ffffff">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="stylesheet" href={css("landing.css")}>
<script is:inline src={js("site-config.js")} defer>
</script>
<script is:inline src={js("site.js")} defer>
</script>
<script is:inline src={js("resource-carousel.js")} defer>
</script>
<script is:inline src={js("resources.js")} defer>
</script>
<link rel="stylesheet" href={css("monochrome.css")}>
<link rel="stylesheet" href={css("resources.css")}>
<link rel="stylesheet" href={css("welcome.css")}>
<script is:inline src={js("welcome.js")} defer>
</script>
<script is:inline src={js("motion.js")} defer></script>
<link rel="stylesheet" href={css("design-system.css")}>
<link rel="stylesheet" href={css("tailwind.css")}>
<Seo lang={lang} route="/trust-and-safety/" title={title} description={description} headline={t('web.trust.headline')} />
</head>
<body class="tw-antialiased">
<a class="skip" href="#main">{t('web.common.skip')}</a>
<Header lang={lang} />
<Navigation lang={lang} />
<main id="main" class="resource-page" data-theme="light">
<section class="section resource-intro">
<p class="label">{t('web.category.safety')}</p>
<h1 set:html={html('web.trust.goodConnectionsRespectfulBeginnings')}></h1>
<p class="resource-lead">{t('web.trust.yourComfortChoiceAnd')}</p>
</section>
<section class="section resource-section">
<p class="label">{t('web.trust.ourApproach')}</p>
<h2 set:html={html('web.trust.respectIsPartOf')}></h2>
<div class="security-carousel" role="region" aria-roledescription="carousel" aria-label={t('web.trust.respectfulIntroductions')}>
<div class="principles-track" tabindex="0" aria-label={t('web.trust.useLeftAndRight')}>
<article class="principle">
<span class="principle-number">01</span>
<h3>{t('web.trust.choiceComesFirst')}</h3>
<p>{t('web.trust.anIntroductionIsAn')}</p>
</article>
<article class="principle">
<span class="principle-number">02</span>
<h3>{t('web.trust.beClearAboutYour')}</h3>
<p>{t('web.trust.ifYouAreHelping')}</p>
</article>
<article class="principle">
<span class="principle-number">03</span>
<h3>{t('web.trust.honestyMatters')}</h3>
<p>{t('web.trust.representYourselfAccuratelyDo')}</p>
</article>
</div>
<div class="principle-controls">
<div class="review-indicators principle-dashes" aria-hidden="true">
<span class="active">
</span>
<span>
</span>
<span>
</span>
</div>
</div>
</div>
</section>
<section class="section resource-band" data-theme="dark">
<p class="label">{t('web.trust.pauseWhenSomethingFeels')}</p>
<h2 set:html={html('web.trust.youDonTOwe')}></h2>
<p>{t('web.trust.requestsForMoneySecrecy')}</p>
<a class="resource-link" href="https://wa.me/94766769894" target="_blank" rel="noopener noreferrer">{t('web.trust.raiseAConcernOn')} <span aria-hidden="true">↗</span>
</a>
</section>
<section class="section resource-section">
<p class="label">{t('web.trust.atYourPace')}</p>
<h2 set:html={html('web.trust.fromFirstHelloTo')}></h2>
<div class="resource-questions">
<details name="resource-answer">
<summary>{t('web.trust.whatStaysPrivateUntil')}<span aria-hidden="true">+</span>
</summary>
<div>
<p>{t('web.trust.contactDetailsSocialHandles')}</p>
</div>
</details>
<details name="resource-answer">
<summary>{t('web.trust.beforeAnIntroduction')}<span aria-hidden="true">+</span>
</summary>
<div>
<p>{t('web.trust.decideWhatYouAre')}</p>
</div>
</details>
<details name="resource-answer">
<summary>{t('web.trust.whileGettingToKnow')}<span aria-hidden="true">+</span>
</summary>
<div>
<p>{t('web.trust.takeTimeToNotice')}</p>
</div>
</details>
<details name="resource-answer">
<summary>{t('web.trust.beforeAFirstMeeting')}<span aria-hidden="true">+</span>
</summary>
<div>
<p>{t('web.trust.chooseAPublicPlace')}</p>
</div>
</details>
<details name="resource-answer">
<summary>{t('web.trust.ifYouWantTo')}<span aria-hidden="true">+</span>
</summary>
<div>
<p>{t('web.trust.youDoNotNeed')}</p>
</div>
</details>
<details name="resource-answer">
<summary>{t('web.trust.ifYouAreSupporting')}<span aria-hidden="true">+</span>
</summary>
<div>
<p>{t('web.trust.askWhatKindOf')}</p>
</div>
</details>
</div>
</section>
<section class="section danger-section" data-theme="light">
<aside class="resource-note">
<h3>
<svg viewBox="0 0 24 24" aria-hidden="true">
<path d="m12 3 10 18H2L12 3Z"/>
<path d="M12 9v5M12 17v.2"/>
</svg>{t('web.trust.immediateDanger')}</h3>
<p>{t('web.trust.contactLocalEmergencyServices')}</p>
<h3>
<svg viewBox="0 0 24 24" aria-hidden="true">
<circle cx="12" cy="12" r="9"/>
<path d="M12 7v5l3 2"/>
</svg>{t('web.trust.whenWeRespond')}</h3>
<p class="response-hours" set:html={html('web.common.hours')}></p>
<p class="response-hours">{t('web.trust.youCanSendA')}</p>
</aside>
</section>
<section class="section resource-end" data-theme="dark">
<div>
<p class="label">{t('web.trust.youSetThePace')}</p>
<h2 set:html={html('web.trust.aLittleSupportCan')}></h2>
<p>{t('web.trust.ifYouAreUnsure')}</p>
</div>
<div class="resource-actions">
<a class="pill" href={path('/help/')}>{t('web.common.exploreHelp')} <span aria-hidden="true">↗</span>
</a>
<a class="pill" href={path('/contact/')}>{t('web.common.contactUs')} <span aria-hidden="true">↗</span>
</a>
<p class="response-hours" set:html={html('web.common.hours')}></p>
</div>
</section>
</main><Footer lang={lang} />
<Dialogs lang={lang} />
</body>
</html>

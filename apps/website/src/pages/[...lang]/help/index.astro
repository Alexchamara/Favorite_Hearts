---
// Help and FAQ (Stage 5b): answers match docs/OWNER-DECISIONS.md and what the app does. Answers are trusted HTML
// written here (some carry a link); search and filters are in assets/js/help.js.
import Header from '../../../components/Header.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';
import Dialogs from '../../../components/Dialogs.astro';
import Seo from '../../../components/Seo.astro';
import { css, js, site } from '../../../lib/site';
import { langOf, languagePaths, texts } from '../../../lib/i18n';

export function getStaticPaths() {
  return languagePaths();
}

const { lang, t, html, path } = texts(langOf(Astro.params.lang));
const title = t('web.common.pageTitle', { page: t('web.help.title') });
const description = t('web.help.description');

// Each answer is HTML from html(): its words escaped, its links ours.
const groups: { id: string; name: string; heading?: string; items: { q: string; a: string }[] }[] = [
  {
    id: 'started',
    name: t('web.help.started.name'),
    items: [
      {
        q: t('web.help.started.q1'),
        a: html('web.help.started.a1'),
      },
      {
        q: t('web.help.started.q2'),
        a: html('web.help.started.a2'),
      },
      {
        q: t('web.help.started.q3'),
        a: html('web.help.started.a3', { link: `<a href="/app/?lang=${lang}">` }),
      },
      {
        q: t('web.help.started.q4'),
        a: html('web.help.started.a4'),
      },
      {
        q: t('web.help.started.q5'),
        a: html('web.help.started.a5'),
      },
      {
        q: t('web.help.started.q6'),
        a: html('web.help.started.a6'),
      },
    ],
  },
  {
    id: 'profiles',
    name: t('web.help.profiles.name'),
    items: [
      {
        q: t('web.help.profiles.q1'),
        a: html('web.help.profiles.a1'),
      },
      {
        q: t('web.help.profiles.q2'),
        a: html('web.help.profiles.a2'),
      },
      {
        q: t('web.help.profiles.q3'),
        a: html('web.help.profiles.a3'),
      },
      {
        q: t('web.help.profiles.q4'),
        a: html('web.help.profiles.a4'),
      },
      {
        q: t('web.help.profiles.q5'),
        a: html('web.help.profiles.a5'),
      },
      {
        q: t('web.help.profiles.q6'),
        a: html('web.help.profiles.a6'),
      },
      {
        q: t('web.help.profiles.q7'),
        a: html('web.help.profiles.a7'),
      },
    ],
  },
  {
    id: 'introductions',
    name: t('web.help.introductions.name'),
    items: [
      {
        q: t('web.help.introductions.q1'),
        a: html('web.help.introductions.a1'),
      },
      {
        q: t('web.help.introductions.q2'),
        a: html('web.help.introductions.a2'),
      },
      {
        q: t('web.help.introductions.q3'),
        a: html('web.help.introductions.a3'),
      },
      {
        q: t('web.help.introductions.q4'),
        a: html('web.help.introductions.a4'),
      },
      {
        q: t('web.help.introductions.q5'),
        a: html('web.help.introductions.a5'),
      },
      {
        q: t('web.help.introductions.q6'),
        a: html('web.help.introductions.a6'),
      },
      {
        q: t('web.help.introductions.q7'),
        a: html('web.help.introductions.a7'),
      },
      {
        q: t('web.help.introductions.q8'),
        a: html('web.help.introductions.a8'),
      },
    ],
  },
  {
    id: 'payments',
    name: t('web.help.payments.name'),
    items: [
      {
        q: t('web.help.payments.q1'),
        a: html('web.help.payments.a1', { link: `<a href="${path('/pricing/')}">` }),
      },
      {
        q: t('web.help.payments.q2'),
        a: html('web.help.payments.a2'),
      },
      {
        q: t('web.help.payments.q3'),
        a: html('web.help.payments.a3', { link: `<a href="${path('/pricing/')}">`, link2: `<a href="${path('/terms/')}">` }),
      },
      {
        q: t('web.help.payments.q4'),
        a: html('web.help.payments.a4'),
      },
      {
        q: t('web.help.payments.q5'),
        a: html('web.help.payments.a5', { link: `<a href="${path('/pricing/')}">` }),
      },
    ],
  },
  {
    id: 'privacy',
    name: t('web.help.privacy.name'),
    items: [
      {
        q: t('web.help.privacy.q1'),
        a: html('web.help.privacy.a1'),
      },
      {
        q: t('web.help.privacy.q2'),
        a: html('web.help.privacy.a2'),
      },
      {
        q: t('web.help.privacy.q3'),
        a: html('web.help.privacy.a3'),
      },
      {
        q: t('web.help.privacy.q4'),
        a: html('web.help.privacy.a4'),
      },
      {
        q: t('web.help.privacy.q5'),

---
// Help and FAQ (Stage 5b): answers match docs/OWNER-DECISIONS.md and what the app does. Answers are trusted HTML
// written here (some carry a link); search and filters are in assets/js/help.js.
import Header from '../../components/Header.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Dialogs from '../../components/Dialogs.astro';
import Seo from '../../components/Seo.astro';
import { css, js, site } from '../../lib/site';

const title = 'Help & FAQ — Favorite Hearts';
const description =
  'Answers about joining Favorite Hearts, verification, family-managed profiles, requests, plans and payments, privacy and safety. Search the FAQ and NFAQ.';

const groups: { name: string; heading?: string; items: { q: string; a: string }[] }[] = [
  {
    name: 'Getting started',
    items: [
      {
        q: 'What is Favorite Hearts?',
        a: 'Favorite Hearts is a matrimony service for Sri Lankans in Sri Lanka and around the world, for people looking for marriage. It is not a dating app and has no chat. Our mission is to make life less lonely by bringing people together to build happy families.',
      },
      {
        q: 'Who is Favorite Hearts for?',
        a: 'Adults aged 18 and over who are considering marriage, and the parents, guardians or family members who help them. The candidate’s own wishes always come first.',
      },
      {
        q: 'How do I join?',
        a: 'Choose <a href="/app/">Join now</a>. You sign in with a 6-digit code sent to your email or phone, and the first code also creates your account. Favorite Hearts staff will never ask you for a code.',
      },
      {
        q: 'How does a profile get published?',
        a: 'Publishing is free. It needs a complete profile and two checks: an identity document (NIC, passport or driving licence) reviewed by our staff, and a phone number verified by SMS. For a profile a family member manages, the manager’s document and phone are checked. We aim to review documents within 48 hours.',
      },
      {
        q: 'Can I join if I live outside Sri Lanka?',
        a: 'Yes. Members abroad use the same app and pay in USD; members in Sri Lanka pay in LKR. Where you live, and where you would like to settle, are good things to discuss early.',
      },
      {
        q: 'What do the badges on a profile mean?',
        a: '<strong>Manager verified</strong>: the family member who manages the profile had their identity document reviewed and their phone verified. <strong>Candidate confirmed</strong>: the candidate accepted the profile themselves. <strong>Candidate identity verified</strong>: the candidate’s own identity document was reviewed. A badge means that check was done. It is not a government verification and cannot guarantee anyone’s intentions.',
      },
    ],
  },
  {
    name: 'Profiles & family',
    items: [
      {
        q: 'Can a parent or family member create a profile?',
        a: 'Yes. A parent, guardian or other family member can create and manage a profile for a candidate, up to 3 profiles each. They confirm that the candidate is 18 or older and has agreed to the profile and to their details being shared after mutual acceptance.',
      },
      {
        q: 'How does the candidate join a profile a family member made?',
        a: 'The manager sends an invitation to the candidate’s own email or phone. The link works once, expires after 24 hours, and needs a code sent to that address. The candidate can confirm the profile, choose what the manager may do and what is shared, decline it, or take it over and manage it alone at any time. A profile that is taken over keeps its plan, and the manager loses access straight away.',
      },
      {
        q: 'What should I include in a profile?',
        a: 'Share an honest introduction, your interests, and what you hope for in a partnership. Details about education, work, and everyday life can help someone start a meaningful conversation.',
      },
      {
        q: 'Which photos should I choose?',
        a: 'Up to 5 recent, clear photos of the candidate, one of them the cover. You choose whether other members see the cover photo; the other photos stay blurred for everyone until you both accept a request. The blurred copies are made on our server, so an original is never sent to someone who may not see it. Use only photos you have permission to share.',
      },
      {
        q: 'How do I change my profile?',
        a: 'In the app: the profile’s details, photos and contact details can be changed at any time by the people allowed to edit it. Never send identity documents by WhatsApp or email; upload them only on the app’s verification page.',
      },
      {
        q: 'Can I hide my profile for a while?',
        a: 'Yes. Pause hides the profile from other members at any time, and you can publish it again later. If you are engaged or married, mark the profile engaged or married: it is hidden and its plan ends, and the remaining time is not refunded.',
      },
      {
        q: 'Does a family introduction mean I have to continue?',
        a: 'No. An introduction is an invitation. Both people should feel free to ask for time, set boundaries, or decide that the connection is not right for them.',
      },
    ],
  },
  {
    name: 'Introductions',
    items: [
      {
        q: 'How does a request work?',
        a: 'A profile with a plan sends a request, and the other side accepts or declines. Only when both have accepted are you connected and contact details shared. A declined request unlocks nothing.',
      },
      {
        q: 'What is shared once we both accept?',
        a: 'The contact details and social handles of the candidate and of the family member who manages the profile, the full photo gallery, and the parents’ names. The candidate can choose in the privacy settings which contact details are shared. Details someone has already seen cannot be taken back.',
      },
      {
        q: 'Can I receive requests without a plan?',
        a: 'Yes. Without a plan you see that a request arrived, with the sender’s age and occupation, but not who sent it. To see the sender and to accept, the profile needs a plan.',
      },
      {
        q: 'How many requests can I send?',
        a: 'Starter: 5 a day and 30 a month. Premium: unlimited requests, fair use applies, up to 30 a day. A day starts at midnight Sri Lanka time. Each request counts once, even if it is later withdrawn or declined.',
      },
      {
        q: 'Can I send another request after a no?',
        a: 'After a decline, a withdrawn request or an ended connection, either side can send a new request to the other after 7 days.',
      },
      {
        q: 'Is there chat inside Favorite Hearts?',
        a: 'No. Once both sides accept, contact details are shared so you can continue in your own way.',
      },
      {
        q: 'Can I end a connection?',
        a: 'Yes, at any time. Both sides lose access to each other’s details from that moment. You can also block a profile, which hides each of you from the other.',
      },
      {
        q: 'What should we talk about first?',
        a: 'Begin with everyday life, what matters to each of you, and the future you hope to build. You do not need to settle every important question in the first conversation.',
      },
    ],
  },
  {
    name: 'Payments',
    items: [
      {
        q: 'Do I need to pay to publish a profile?',
        a: 'No. Publishing is free once you are verified. A plan lets the profile send requests, see who is interested and accept requests. See <a href="/pricing/">plans and prices</a>.',
      },
      {
        q: 'How do payments work?',
        a: 'By transfer, never automatically. You choose a plan in the app, pay the exact amount with the reference the app gives you, and upload a photo or screenshot of the receipt. The plan starts once we find your payment in our bank, Wise or PayPal statement: a receipt alone is not enough. We aim to check payments within 48 hours.',
      },
      {
        q: 'What is the refund policy?',
        a: 'There are no refunds once a plan is active, except for a duplicate payment, a payment made by mistake, or a failure on our side. The details are on the <a href="/pricing/">pricing page</a> and in our <a href="/terms/">terms</a>.',
      },
      {
        q: 'Can I ask about a payment I have made?',
        a: 'Yes. Contact us with the payment reference (FH followed by six letters and numbers). Never send passwords, codes, card numbers or full bank statements.',
      },
      {
        q: 'Where can I see the prices?',
        a: 'On the <a href="/pricing/">pricing page</a>, and in the app when you choose a plan. Do not rely on prices in social media comments or in messages from other people.',
      },
    ],
  },
  {
    name: 'Privacy & safety',
    items: [
      {
        q: 'Who can see my profile?',
        a: 'Only signed-in members whose own identity check is complete can browse published profiles. Visitors who are not signed in see no profiles at all. Contact details and the full photo gallery are shared only after both sides accept.',
      },
      {
        q: 'Do I have to give my caste or religion?',
        a: 'No. Both are optional, with “Prefer not to say”. Caste is saved only with your explicit consent, is shown only to signed-in members, and can be removed at any time. Income is optional, shown as a range and labelled self-declared.',
      },
      {
        q: 'Will Favorite Hearts ever ask for my password or code?',
        a: 'Never. Favorite Hearts staff will never ask for a password or a sign-in code, by phone, WhatsApp, email or anywhere else. Anyone who asks is not us.',
      },
      {
        q: 'How do I report someone?',
        a: 'Use Report on their profile. A report about explicit content, a minor, threats or a scam hides the profile at once until our staff review it; other reports hide it once three different verified members report it. Staff restore anything hidden by mistake. You can also block the profile. If you are in danger, contact local emergency services.',
      },
      {
        q: 'What if someone asks me for money?',
        a: 'Do not send money to someone you have only met online. Stop and seek support if a person pressures you to pay, invest, share bank details, or keep financial requests secret.',
      },
      {
        q: 'How should I prepare for a first meeting?',
        a: 'Choose a public place, arrange your own transport, and tell someone you trust where you are going. Meet at a pace you feel comfortable with and leave if you feel uneasy.',
      },
      {
        q: 'How long do you keep my information?',
        a: 'Identity documents are deleted 90 days after the review. When you delete a profile or your account it disappears at once, and a short list of records, such as payment records, reports and blocks, is kept for 6 months and then deleted. The <a href="/privacy/">privacy policy</a> lists everything.',
      },
      {
        q: 'Can I download or delete my data?',
        a: `Yes. In the app, Your account has Download my data (one ZIP file with your profiles, contact details, photos, requests, connections and payments) and Delete my account. For anything else, email <a href="mailto:${site.email}">${site.email}</a> with the subject “Privacy request”.`,
      },
    ],
  },
  {
    name: 'NFAQ',
    heading: 'Not-so frequently asked questions',
    items: [
      {
        q: 'What does NFAQ mean?',
        a: 'Not-so frequently asked questions: the things you might be wondering about, even if they do not come up in every conversation.',
      },
      {
        q: 'Do we need to agree on everything?',
        a: 'No two people are identical. What matters is having room to talk honestly about differences, understand each other’s priorities, and decide what you can build together.',
      },
      {
        q: 'What if my family and I want different things?',
        a: 'Try explaining what matters to you and the kind of support you would welcome. Family can offer perspective, but your own willingness should never be replaced by pressure.',
      },
      {
        q: 'Does Favorite Hearts guarantee a marriage?',
        a: 'No. A meaningful partnership depends on the people involved. Introductions can create opportunities, but neither a profile nor a plan can guarantee a relationship or marriage.',
      },
      {
        q: 'Is horoscope matching available?',
        a: 'No. A profile can say how important horoscope matching is to the family, so you can talk about it, but Favorite Hearts does not match horoscopes.',
      },
      {
        q: 'When can I contact the team?',
        a: 'Our support hours are daily, 8:00 AM–10:00 PM, Sri Lanka time. You can call or send a WhatsApp message to 076 676 9894, or email us; messages outside those hours are answered when we are back. Favorite Hearts is not an emergency service.',
      },
    ],
  },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#ffffff">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="stylesheet" href={css("landing.css")}>
<script is:inline src={js("site-config.js")} defer>
</script>
<script is:inline src={js("site.js")} defer>
</script>
<script is:inline src={js("help.js")} defer>
</script>
<link rel="stylesheet" href={css("monochrome.css")}>
<link rel="stylesheet" href={css("help.css")}>
<link rel="stylesheet" href={css("welcome.css")}>
<script is:inline src={js("welcome.js")} defer>
</script>
<script is:inline src={js("motion.js")} defer></script>
<link rel="stylesheet" href={css("design-system.css")}>
<link rel="stylesheet" href={css("tailwind.css")}>
<Seo route="/help/" title={title} description={description} headline={"Good questions. Thoughtful answers."} />
</head>
<body class="tw-antialiased">
<a class="skip" href="#main">Skip to content</a>
<Header />
<Navigation />
<main id="main" class="help-page" data-theme="light">
<section class="section help-intro">
<p class="label">A little guidance</p>
<h1>Good questions.<br>Thoughtful answers.</h1>
<p>From first introductions to the things you’re wondering about.<br>Find a little clarity here.</p>
<label class="help-search" for="help-search">
<svg viewBox="0 0 24 24" aria-hidden="true">
<circle cx="10.5" cy="10.5" r="6.5"/>
<path d="m16 16 5 5"/>
</svg>
<input id="help-search" type="search" placeholder="Search questions and answers" autocomplete="off">
<span class="sr-only">Search help and frequently asked questions</span>
</label>
<div class="help-filters" role="group" aria-label="Filter questions by category">
<button type="button" data-category="All questions" aria-pressed="true">All questions</button>
{groups.map((group) => (
<button type="button" data-category={group.name} aria-pressed="false">{group.name}</button>
))}
</div>
</section>
<section class="section help-content" aria-label="Help and frequently asked questions">
<p id="help-status" class="sr-only" role="status" aria-live="polite">
</p>
{groups.map((group) => (
<section class="faq-group" data-group={group.name}>
<div class="faq-group-heading">
<h2>{group.name}</h2>
{group.heading && <p>{group.heading}</p>}
</div>
<div class="faq-items">
{group.items.map((item) => (
<details name="help-answer" data-category={group.name}>
<summary>{item.q}<span aria-hidden="true">+</span>
</summary>
<div class="faq-answer">
<p set:html={item.a} />
</div>
</details>
))}
</div>
</section>
))}
<div id="help-empty" hidden>
<h2>No answers found.</h2>
<p>Try a different word, choose another category, or ask our team.</p>
<button class="pill" id="help-reset">Show all questions</button>
</div>
</section>
<section class="section help-contact" data-theme="dark">
<div>
<p class="label">We’re here for you</p>
<h2>Still have<br>a question?</h2>
<p>Some things need a conversation. Tell us what’s on your mind and we’ll help you find the next step. Favorite Hearts staff will never ask for a password or a code.</p>
</div>
<div class="help-contact-actions">
<a class="help-direct" href="https://wa.me/94766769894" target="_blank" rel="noopener noreferrer">WhatsApp · 076 676 9894 <span aria-hidden="true">↗</span>
</a>
<a class="help-direct" href={`tel:${site.telephone}`}>Call · 076 676 9894 <span aria-hidden="true">↗</span>
</a>
<a class="help-direct" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">↗</span>
</a>
<p>Daily, 8:00 AM–10:00 PM<br>Sri Lanka time</p>
<a class="pill" href="/contact/">Contact us <span aria-hidden="true">↗</span>
</a>
</div>
</section>
</main><Footer />
<Dialogs />
</body>
</html>

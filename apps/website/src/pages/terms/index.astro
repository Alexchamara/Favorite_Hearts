---
// Terms and conditions (Stage 5b): a draft for the owner's lawyer that states every rule docs/OWNER-DECISIONS.md assigns
// to the terms (audit rows W08, W09, X02). The points the lawyer must check are listed in docs/LEGAL-REVIEW.md.
import LegalPage, { type LegalSection } from '../../components/LegalPage.astro';
import { site } from '../../lib/site';

const operator = '<mark class="legal-placeholder">[operator’s legal name and address]</mark>';
const email = `<a href="mailto:${site.email}">${site.email}</a>`;

const sections: LegalSection[] = [
  {
    id: 'about',
    title: 'About these terms',
    body: [
      `These terms are an agreement between you and the operator of Favorite Hearts, ${operator} (“we”, “us”). They apply when you use the Favorite Hearts website or app, create an account, run a profile or buy a plan. If you do not agree, please do not use Favorite Hearts.`,
      'The English text is the official version. A Sinhala translation is provided for convenience; if the two differ, the English text applies.',
    ],
  },
  {
    id: 'service',
    title: 'What Favorite Hearts is',
    body: [
      'Favorite Hearts is a matrimony service for adults who are looking for marriage, in Sri Lanka and abroad. It is not a dating service and it has no chat. We help people find each other; we do not arrange marriages, and we cannot guarantee a match, a relationship or a marriage.',
    ],
  },
  {
    id: 'eligibility',
    title: 'Who may use it',
    body: [
      'You must be 18 or older. A profile may only be created for an adult who is looking for marriage.',
      'You may hold one account. Favorite Hearts staff will never ask for your password or a sign-in code.',
    ],
  },
  {
    id: 'accounts',
    title: 'Your account and verification',
    body: [
      'You sign in with a code sent to your email or phone. Keep them private: you are responsible for what is done with your account.',
      'A profile is published only after the identity document of the person who runs it (NIC, passport or driving licence) has been reviewed by our staff and their phone number has been verified by SMS. The badges on a profile mean exactly this:',
      [
        '<strong>Manager verified</strong>: the family member who manages the profile had their identity document reviewed and their phone verified.',
        '<strong>Candidate confirmed</strong>: the candidate accepted the profile themselves.',
        '<strong>Candidate identity verified</strong>: the candidate’s own identity document was reviewed.',
      ],
      'A badge is not a government verification and does not guarantee anyone’s identity or intentions. Upload identity documents only through the verification page of the app: we never accept them by WhatsApp, email or any other way.',
    ],
  },
  {
    id: 'managers',
    title: 'Running a profile for someone else',
    body: [
      'A parent, guardian or other family member may create and manage a profile for a candidate, up to 3 profiles unless we agree to more. By creating one, you confirm that the candidate is 18 or older, that they have given you permission to create the profile, and that they agree to their contact details being shared with members they connect with, as described below.',
      'Until the candidate confirms the profile, their details are shared on your word, and a phone number you entered for them is shown as “not verified by candidate”. You must hide or delete the profile, or stop sharing their details, as soon as the candidate asks.',
      'The candidate can join the profile by invitation at any time, choose what you may do and what is shared, have it hidden, take it over, or delete it. When a candidate takes the profile over, you lose all access to it straight away, your own contact details are removed from it, and any paid time stays with the profile.',
    ],
  },
  {
    id: 'connections',
    title: 'Requests, connections and sharing',
    body: [
      'A profile with a plan can send requests. A connection is made only when both sides accept; a declined request unlocks nothing.',
      'Once both sides accept, the contact details and social handles of the candidate and of the family member who manages the profile, the full photo gallery and the parents’ names are shared with the other side. The candidate can limit which contact details are shared in the privacy settings. Details that have been shared cannot be taken back.',
      'Either side can end a connection or block a profile at any time; access to each other’s details ends from that moment. After a decline, a withdrawn request or an ended connection, a new request between the same two profiles can be sent after 7 days.',
      'You may use the contact details you receive only to get to know that person with a view to marriage. Do not pass them on or use them for anything else.',
    ],
  },
  {
    id: 'plans',
    title: 'Plans and prices',
    body: [
      'Creating and publishing a profile is free. A plan lets a profile send requests, see who sent requests to it, and accept requests. Each profile has its own plan.',
      'The plans, their length, their limits and their prices are shown on our <a href="/pricing/">pricing page</a> and in the app. Starter allows 5 requests a day and 30 a month. Premium is offered as unlimited requests, fair use applies: it allows up to 30 requests a day. A day starts at midnight Sri Lanka time. A request counts when it is sent, even if it is later withdrawn or declined.',
      'If you live in Sri Lanka you pay the local price in LKR; if you live anywhere else you pay the overseas price in USD. You must state the country you live in truthfully. We may compare it with how you pay and with your reviewed document, and ask you about a difference.',
      'We may change our plans and prices. A change never affects a plan that is already paid for.',
    ],
  },
  {
    id: 'payments',
    title: 'Paying',
    body: [
      'You pay by bank transfer in Sri Lanka, or by international transfer (SWIFT), Wise or PayPal from abroad, to the details shown in the app, with the unique reference the app gives you. You then upload a photo or screenshot of the receipt.',
      'A plan starts only when we have found your payment in our own bank, Wise or PayPal statement; a receipt alone is not enough. We aim to check payments within 48 hours. If we cannot match a payment, we tell you why.',
      'Plans never renew automatically, and we never take a payment without your action.',
    ],
  },
  {
    id: 'changes',
    title: 'Changing, renewing and ending a plan',
    body: [
      'You may move to a higher plan at any time. It starts when we approve the payment, and the unused days of your current plan are lost; the app shows exactly how many before you pay. A lower plan can be bought once the current plan has ended.',
      'You may renew the same plan in its last 7 days. The new term counts from the day we approve the payment. If you send a renewal receipt before the plan ends, access continues for up to 3 days after the end while we check it.',
      'When a plan ends, you can no longer see anyone’s contact details or social handles, including your connections’. Your connections remain, and their details become visible again when you renew. We remind you before a plan ends.',
    ],
  },
  {
    id: 'refunds',
    title: 'Refunds, disputes and lost time',
    body: [
      'There are no refunds once a plan is active, except for:',
      ['a duplicate payment;', 'a payment made by mistake;', 'a failure on our side.'],
      'You confirm that you have read this before you pay.',
      'If a payment is reversed or disputed after the plan started, for example through PayPal, we may end the plan it paid for.',
      'If we suspend a profile for breaking these terms, its remaining plan time is lost. If you mark a profile engaged or married, or delete it or your account, its plan ends and the remaining time is not refunded.',
      'Nothing in these terms takes away rights you have under consumer protection law.',
    ],
  },
  {
    id: 'conduct',
    title: 'How you must behave',
    body: [
      [
        'Be honest about yourself and about the candidate. Do not impersonate anyone, or create a profile for someone without their permission.',
        'Never create or manage a profile for anyone under 18.',
        'Do not harass, threaten or deceive anyone, ask anyone for money, or send explicit content.',
        'Use Favorite Hearts only to look for a marriage partner, not to sell, advertise or recruit.',
        'Do not copy profiles, collect members’ information, or try to get around our access rules, limits or security.',
        'Do not make false reports.',
      ],
    ],
  },
  {
    id: 'safety',
    title: 'Reports and moderation',
    body: [
      'Any verified member can report a profile or a photo. A report about explicit content, a minor, threats or a scam hides it at once; any other report hides it once three different verified members have reported it. Our staff review everything that is hidden, restore it if it was hidden by mistake, and may warn, suspend or remove a member who breaks these terms. Repeated false reporting has consequences.',
      'If you are worried about someone’s safety, contact local emergency services first. Favorite Hearts is not an emergency service.',
    ],
  },
  {
    id: 'content',
    title: 'Your content',
    body: [
      'You are responsible for what you add to a profile, including photos you have permission to share. You keep your rights in it, and you allow us to store it and to show it to other members as these terms and our <a href="/privacy/">privacy policy</a> describe, for as long as it is on Favorite Hearts.',
      'Photos are shown blurred to anyone who may not yet see them; we make the blurred copies.',
      'The Favorite Hearts name, design and text belong to us or to those who licensed them to us.',
    ],
  },
  {
    id: 'ending',
    title: 'Pausing, deleting and leaving',
    body: [
      'You can pause a profile, mark it engaged or married, delete a profile, or delete your whole account at any time in the app. Deleting needs a recent sign-in.',
      'A deleted profile disappears at once. What is deleted, what we keep and for how long is set out in our <a href="/privacy/">privacy policy</a>.',
      'We may suspend or close an account that breaks these terms, after reviewing it.',
    ],
  },
  {
    id: 'liability',
    title: 'Our responsibility',
    body: [
      'We work to keep Favorite Hearts available, accurate and secure, but we cannot promise that it will always be available or free of errors. We are not responsible for what members do outside Favorite Hearts, including when they meet. Meet in a public place and tell someone you trust.',
      'Any limit on our responsibility applies only as far as the law allows, and nothing in these terms limits a responsibility that the law does not allow to be limited.',
    ],
  },
  {
    id: 'law',
    title: 'Changes, law and contact',
    body: [
      'We may update these terms. We tell members about important changes before they take effect; continuing to use Favorite Hearts after that means you accept them.',
      'These terms are governed by the laws of Sri Lanka, and the courts of Sri Lanka decide any dispute about them, without removing any protection the law of the country you live in gives you.',
      `Questions about these terms: ${operator}, ${email}, or WhatsApp and calls on 076 676 9894.`,
    ],
  },
];
---
<LegalPage
  route="/terms/"
  title="Terms & Conditions — Favorite Hearts"
  heading="Terms & Conditions"
  description="The rules of Favorite Hearts: eligibility, verification, profiles run by family, sharing, plans, payments, refunds and conduct. Draft awaiting legal review."
  lead="A clear understanding, from the beginning."
  updated="31 October 2026"
  sections={sections}
  other={{ href: '/privacy/', label: 'Privacy Policy' }}
/>

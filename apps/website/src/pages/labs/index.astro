---
// Converted from the demo page src/pages/labs/index.html — content unchanged.
import Header from '../../components/Header.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Dialogs from '../../components/Dialogs.astro';
import Seo from '../../components/Seo.astro';
import { css, js } from '../../lib/site';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#ffffff">
<title>Favorite Labs — Favorite Hearts</title>
<meta name="description" content="Favorite Labs shares practical ideas about values, family and the everyday choices behind a lasting partnership, for matrimony in Sri Lanka and beyond.">
<link rel="stylesheet" href={css("landing.css")}>
<script is:inline src={js("site-config.js")} defer>
</script>
<script is:inline src={js("site.js")} defer>
</script>
<script is:inline src={js("labs.js")} defer>
</script>
<link rel="stylesheet" href={css("monochrome.css")}>
<link rel="stylesheet" href={css("labs.css")}>
<link rel="stylesheet" href={css("welcome.css")}>
<script is:inline src={js("welcome.js")} defer>
</script>
<script is:inline src={js("motion.js")} defer></script>
<link rel="stylesheet" href={css("design-system.css")}>
<link rel="stylesheet" href={css("tailwind.css")}>
<Seo route="/labs/" title={"Favorite Labs — Favorite Hearts"} description={"Favorite Labs shares practical ideas about values, family and the everyday choices behind a lasting partnership, for matrimony in Sri Lanka and beyond."} headline={"Ideas for a shared life."} />
</head>
<body class="tw-antialiased">
<a class="skip" href="#main">Skip to content</a>
<Header />
<Navigation />
<main id="main" class="labs-page">
<section class="labs-opening" data-theme="light">
<div class="labs-cover">
<img src="https://images.pexels.com/photos/8836421/pexels-photo-8836421.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=2400&amp;q=90" alt="A couple enjoying a conversation in a coffee shop" fetchpriority="high" width="1600" height="1067" data-stock-fallback="/assets/labs-couple.jpg" decoding="async">
</div>
<div class="section">
<p class="labs-wordmark">favorite<span>Labs</span>
</p>
<h1 data-reveal>Ideas for<br>
<span class="scientists-mark">a shared life.<svg class="draw-underline" viewBox="0 0 420 30" preserveAspectRatio="none" aria-hidden="true">
<defs>
<filter id="underline-ink" x="-10%" y="-50%" width="120%" height="200%">
<feTurbulence type="fractalNoise" baseFrequency=".32" numOctaves="3" seed="8" result="rough"/>
<feDisplacementMap in="SourceGraphic" in2="rough" scale="1.65" xChannelSelector="R" yChannelSelector="G"/>
</filter>
</defs>
<path filter="url(#underline-ink)" pathLength="1" d="M8 18 C75 10 139 19 201 14 S324 11 411 16"/>
</svg>
</span>
</h1>
</div>
</section>
<section class="section labs-science" data-theme="light">
<p class="label" data-reveal>Our Approach to Connection</p>
<h2 data-reveal>Understanding people.<br>Building lasting love.</h2>
<div class="offset">
<p data-reveal>Favorite Labs shares ideas about the values, conversations and everyday choices behind lasting partnerships, for matrimony in Sri Lanka and beyond. They are ideas to talk about together, not research findings.</p>
</div>
</section>
<div class="labs-photo" data-theme="light">
<img src="https://images.pexels.com/photos/3967505/pexels-photo-3967505.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=2400&amp;q=90" alt="A couple sharing coffee and looking at each other" loading="lazy" width="1536" height="1024" data-stock-fallback="/assets/labs-couple.jpg" decoding="async">
</div>
<section class="section labs-reading" id="advice" data-theme="light">
<h2 data-reveal>Ideas &amp; Advice <sup>(6)</sup>
</h2>
<div class="article-grid">
<article class="advice-card">
<a class="article-open" href="/newsroom/beyond-the-checklist/">
<div class="article-image">
<img src="https://images.pexels.com/photos/5910748/pexels-photo-5910748.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=2400&amp;q=90" alt="" loading="lazy" data-stock-fallback="/assets/labs-couple.jpg" decoding="async">
</div>
<span class="article-meta">
<span class="article-category">Shared Values</span>
<time class="article-date" datetime="2026-10">October 2026</time>
</span>
<h3>Beyond the checklist: what does a shared life look like?</h3>
<span class="article-tag">Read the story <span aria-hidden="true">↗</span>
</span>
</a>
</article>
<article class="advice-card">
<a class="article-open" href="/newsroom/a-first-conversation/">
<div class="article-image">
<img src="https://images.pexels.com/photos/8836421/pexels-photo-8836421.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=2400&amp;q=90" alt="" loading="lazy" data-stock-fallback="/assets/labs-couple.jpg" decoding="async">
</div>
<span class="article-meta">
<span class="article-category">Conversations</span>
<time class="article-date" datetime="2026-10">October 2026</time>
</span>
<h3>A first conversation that feels like you.</h3>
<span class="article-tag">Read the story <span aria-hidden="true">↗</span>
</span>
</a>
</article>
<article class="advice-card">
<a class="article-open" href="/newsroom/family-and-your-voice/">
<div class="article-image">
<img src="https://images.pexels.com/photos/3967505/pexels-photo-3967505.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=2400&amp;q=90" alt="" loading="lazy" data-stock-fallback="/assets/labs-couple.jpg" decoding="async">
</div>
<span class="article-meta">
<span class="article-category">Family & Choice</span>
<time class="article-date" datetime="2026-10">October 2026</time>
</span>
<h3>Family can be part of the journey. Your voice comes first.</h3>
<span class="article-tag">Read the story <span aria-hidden="true">↗</span>
</span>
</a>
</article>
<article class="advice-card" hidden>
<a class="article-open" href="/newsroom/across-borders-on-the-same-page/">
<div class="article-image">
<img src="https://images.pexels.com/photos/5910748/pexels-photo-5910748.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=2400&amp;q=90" alt="" loading="lazy" data-stock-fallback="/assets/labs-couple.jpg" decoding="async">
</div>
<span class="article-meta">
<span class="article-category">Sri Lanka & Beyond</span>
<time class="article-date" datetime="2026-10">October 2026</time>
</span>
<h3>Across borders, on the same page.</h3>
<span class="article-tag">Read the story <span aria-hidden="true">↗</span>
</span>
</a>
</article>
<article class="advice-card" hidden>
<a class="article-open" href="/newsroom/before-marriage/">
<div class="article-image">
<img src="https://images.pexels.com/photos/3967505/pexels-photo-3967505.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=2400&amp;q=90" alt="" loading="lazy" data-stock-fallback="/assets/labs-couple.jpg" decoding="async">
</div>
<span class="article-meta">
<span class="article-category">Everyday Partnership</span>
<time class="article-date" datetime="2026-10">October 2026</time>
</span>
<h3>The little things worth talking about before marriage.</h3>
<span class="article-tag">Read the story <span aria-hidden="true">↗</span>
</span>
</a>
</article>
<article class="advice-card" hidden>
<a class="article-open" href="/newsroom/an-honest-profile/">
<div class="article-image">
<img src="https://images.pexels.com/photos/8836421/pexels-photo-8836421.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=2400&amp;q=90" alt="" loading="lazy" data-stock-fallback="/assets/labs-couple.jpg" decoding="async">
</div>
<span class="article-meta">
<span class="article-category">Getting Started</span>
<time class="article-date" datetime="2026-10">October 2026</time>
</span>
<h3>A thoughtful introduction starts with an honest profile.</h3>
<span class="article-tag">Read the story <span aria-hidden="true">↗</span>
</span>
</a>
</article>
</div>
<div class="all-posts">
<button class="pill" id="all-posts" aria-expanded="false">All posts</button>
</div>
</section>
<section class="section labs-press" data-theme="dark">
<div class="press-row">
<p class="label">News &amp; Media</p>
<h3>Follow our next chapter.</h3>
<p>Future announcements and press updates will be shared in our newsroom.</p>
<a href="/newsroom/" class="labs-text-link">Visit our newsroom <span aria-hidden="true">↗</span>
</a>
</div>
</section>
<section class="section begin join" data-theme="light">
<p class="label" data-reveal>Your Next Chapter</p>
<h2 data-reveal>Make room for<br>your person.</h2>
<p>A shared life starts with getting to know someone. Begin your next chapter with Favorite Hearts.</p>
<button class="pill start">Join now</button>
</section>
</main><Footer />
<Dialogs />
</body>
</html>

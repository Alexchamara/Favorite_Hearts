# Response headers for the static host (Cloudflare Pages). Every rule whose path matches applies; a header set by two
# rules is joined with ", ", and "! Name" removes one set by an earlier rule.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://images.pexels.com; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
# The member app brings its own Content-Security-Policy in its page (apps/member/vite.config.ts): it needs Cloudflare
# Turnstile, the API and photo links that the website's policy above would block. Framing stays denied by X-Frame-Options.
/app/*
  ! Content-Security-Policy
  # Document photos can be taken with the computer's camera (owner, 5 Nov 2026); only the app's own pages may ask.
  ! Permissions-Policy
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  X-Robots-Tag: noindex, nofollow
/app/assets/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=3600
/*.html
  Cache-Control: no-cache

{
  "name": "@fh/website",
  "version": "0.1.0",
  "private": true,
  "description": "Public marketing website: Astro static pages, almost no JavaScript.",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/styles/tailwind.css -o public/assets/css/tailwind.css --minify",
    "build": "npm run build:css && astro build",
    "preview": "astro preview --port 4321",
    "typecheck": "astro check"
  },
  "dependencies": {
    "astro": "^5.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "tailwindcss": "3.4.17"
  }
}

# Copy to apps/api/.env (gitignored). Hosted: set these as Fly.io / Railway secrets.
# Never put any of these in the member app or the website.

NODE_ENV=development
PORT=8787
# Public URL of this API (Better-Auth base URL). Must be https in staging/production.
API_URL=http://localhost:8787
# Member app address used in invitation links (no trailing slash). Must be https in staging/production.
MEMBER_APP_URL=http://localhost:4321/app
# Browser origins allowed to call the API with cookies (comma-separated). Better-Auth refuses requests
# from any other origin ("Invalid origin"), and the API will not start without MEMBER_APP_URL's origin.
# Local: the website (:4321) and the member app's dev server (:5173) both proxy /api; list both.
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173

# --- Database: Neon Postgres ----------------------------------------------
# Pooled connection (host contains "-pooler") for API queries.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/favorite_hearts?sslmode=verify-full
# Direct connection for migrations (drizzle-kit) and pg-boss (needs session features).
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/favorite_hearts?sslmode=verify-full

# --- Auth: Better-Auth ------------------------------------------------------
# 32+ random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# --- Email codes: Resend ----------------------------------------------------
RESEND_API_KEY=
# Until the domain is bought and verified in Resend, only onboarding@resend.dev works as
# sender, and Resend delivers ONLY to the email address that owns the Resend account.
EMAIL_FROM=Favorite Hearts <onboarding@resend.dev>
EMAIL_REPLY_TO=

# --- SMS codes: provider chosen later ---------------------------------------
# none = not configured: SMS sign-in returns a clear error (never a fake success).
# log  = LOCAL DEVELOPMENT ONLY: prints the code to the API console.
SMS_PROVIDER=none
SMS_SENDER_ID=FavHearts
# Provider credentials are added when the provider is chosen, e.g. SMS_API_KEY=

# --- Files: Cloudflare R2 (private buckets) ----------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# ID documents, payment proofs and original photos.
R2_BUCKET_PRIVATE=fh-private-staging
# Blurred photo derivatives (still private; served only via short-lived signed URLs).
R2_BUCKET_DERIVED=fh-derived-staging
SIGNED_URL_TTL_SECONDS=120

# --- Background jobs: pg-boss -----------------------------------------------
# Run the job workers inside this API process (true locally; one instance in production).
RUN_JOBS=true

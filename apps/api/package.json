{
  "name": "@fh/api",
  "version": "0.1.0",
  "private": true,
  "description": "Favorite Hearts API: Hono on Node. The single security boundary for all member and staff data.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "npx auth@latest generate --config src/auth.ts --output src/db/schema/auth.generated.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@better-auth/drizzle-adapter": "^1.6.22",
    "@fh/shared": "*",
    "@hono/node-server": "^1.14.0",
    "better-auth": "^1.6.22",
    "drizzle-orm": ">=0.44.0 <1.0.0",
    "hono": "^4.9.0",
    "pg": "^8.16.0",
    "pg-boss": "^10.1.0",
    "sharp": "^0.34.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": ">=0.31.0 <1.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  }
}

# Copy to apps/member/.env.local. Everything prefixed VITE_ is bundled into the browser,
# so only PUBLIC values belong here — never an API key or secret.

# API origin. Leave empty locally: the Vite dev server proxies /api to localhost:8787.
# Staging/production: e.g. https://api.yourdomain (same registrable domain as the app,
# so the sign-in cookie is first-party).
VITE_API_URL=

# Login code channels. Keep SMS off until an SMS provider is configured in the API.
VITE_LOGIN_EMAIL_ENABLED=true
VITE_LOGIN_SMS_ENABLED=false

# Cloudflare Turnstile site key (Stage 4). Leave empty until then.
VITE_TURNSTILE_SITE_KEY=
